{
  "schemaVersion": 1,
  "mode": "development-branch",
  "description": "Single source of truth for Kaspa Gateway embedded Rusty Kaspa runtime repository bindings.",
  "rules": {
    "bindingScope": "build-time",
    "runtimeStartedByBindingTools": false,
    "externalKaspadExeAllowed": false,
    "sameExeSelfWorkerRequired": true,
    "cargoLockMustBeCommitted": true,
    "releaseModeShouldPinRev": true
  },
  "networks": {
    "mainnet": {
      "family": "mainline",
      "repo": "https://github.com/kaspanet/rusty-kaspa.git",
      "branch": "master",
      "rev": "a07d8b38d45f38a02a1f35f601e874358f6c7846",
      "feature": "official-kaspa-runtime-mainline",
      "nodeAliases": [
        "kaspad-lib-mainline",
        "kaspa-core-mainline",
        "kaspa-utils-mainline"
      ],
      "bridgeAliases": [
        "kaspa-stratum-bridge-mainline"
      ],
      "packages": {
        "node": [
          "kaspad",
          "kaspa-core",
          "kaspa-utils"
        ],
        "bridge": [
          "kaspa-stratum-bridge"
        ]
      }
    },
    "testnet10": {
      "family": "tn12",
      "repo": "https://github.com/LiveLaughLove13/rusty-kaspa.git",
      "branch": "RKStratumTN12",
      "rev": "eeb351ee911e2df906d21203dec8db3a195c6b33",
      "feature": "official-kaspa-runtime-tn12",
      "nodeAliases": [
        "kaspad-lib-tn12",
        "kaspa-core-tn12",
        "kaspa-utils-tn12"
      ],
      "bridgeAliases": [
        "kaspa-stratum-bridge-tn12"
      ],
      "packages": {
        "node": [
          "kaspad",
          "kaspa-core",
          "kaspa-utils"
        ],
        "bridge": [
          "kaspa-stratum-bridge"
        ]
      }
    },
    "testnet12": {
      "family": "tn12",
      "repo": "https://github.com/LiveLaughLove13/rusty-kaspa.git",
      "branch": "RKStratumTN12",
      "rev": "eeb351ee911e2df906d21203dec8db3a195c6b33",
      "feature": "official-kaspa-runtime-tn12",
      "nodeAliases": [
        "kaspad-lib-tn12",
        "kaspa-core-tn12",
        "kaspa-utils-tn12"
      ],
      "bridgeAliases": [
        "kaspa-stratum-bridge-tn12"
      ],
      "packages": {
        "node": [
          "kaspad",
          "kaspa-core",
          "kaspa-utils"
        ],
        "bridge": [
          "kaspa-stratum-bridge"
        ]
      }
    }
  }
}
