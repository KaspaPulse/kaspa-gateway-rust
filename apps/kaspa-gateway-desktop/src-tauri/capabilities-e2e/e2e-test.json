{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "e2e-test-capability",
  "description": "Optional WebDriver permissions for local E2E builds only",
  "windows": [
    "main"
  ],
  "permissions": [
    "wdio:allow-execute",
    "wdio:allow-log-frontend",
    "wdio:allow-debug-plugin",
    "wdio:allow-get-active-window-label",
    "wdio:allow-get-window-states",
    "wdio:allow-list-windows",
    "wdio-webdriver:default"
  ]
}
